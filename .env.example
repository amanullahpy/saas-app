# Copy to `.env.local` and adjust. All runtime branding and URLs are read from here
# (see `src/config/env.ts` — no duplicate literals elsewhere).

# Product / SEO
NEXT_PUBLIC_APP_NAME=Aetheris
NEXT_PUBLIC_APP_NAME_FULL=Aetheris Platform
NEXT_PUBLIC_APP_DESCRIPTION=Enterprise-grade modular SaaS frontend system

# Canonical site URL (used for metadataBase and absolute URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First path after locale when visiting /en or /ur (e.g. /auth/login or /dashboard)
NEXT_PUBLIC_LANDING_PATH=/auth/login

# Auth: mock = seed users + local registry (see src/config/auth.ts). http = implement src/services/auth/http.provider.ts
NEXT_PUBLIC_AUTH_DRIVER=mock
# Optional artificial delay (ms) for mock sign-in/up
# NEXT_PUBLIC_AUTH_MOCK_DELAY_MS=450
